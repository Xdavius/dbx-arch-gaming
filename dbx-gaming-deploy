#!/usr/bin/env bash

set -Eeuo pipefail

readonly DEFAULT_BOX_NAME="arch-gaming"
readonly DEFAULT_IMAGE="docker.io/library/archlinux:latest"

BOX_NAME="${BOX_NAME:-$DEFAULT_BOX_NAME}"
IMAGE="${IMAGE:-$DEFAULT_IMAGE}"
USE_NVIDIA="${USE_NVIDIA:-}"
GPU_VENDOR="${GPU_VENDOR:-}"
CONTAINER_MANAGER="${CONTAINER_MANAGER:-${DBX_CONTAINER_MANAGER:-}}"
DEBUG="${DEBUG:-n}"
BOX_HOME="${BOX_HOME:-}"

PACMAN_PACKAGES=(
  base-devel
  git
  curl
  wget
  vim
)

NVIDIA_PACKAGES=(
  nvidia-utils
  lib32-nvidia-utils
)

COMMON_VULKAN_PACKAGES=(
  vulkan-icd-loader
  lib32-vulkan-icd-loader
  vulkan-tools
)

AMD_VULKAN_PACKAGES=(
  mesa
  lib32-mesa
  vulkan-radeon
  lib32-vulkan-radeon
  vulkan-mesa-layers
  lib32-vulkan-mesa-layers
)

INTEL_VULKAN_PACKAGES=(
  mesa
  lib32-mesa
  vulkan-intel
  lib32-vulkan-intel
  vulkan-mesa-layers
  lib32-vulkan-mesa-layers
)

GAMING_PACKAGES=(
  steam
  lutris
  heroic-games-launcher-bin
  protonplus
  gamemode
  lib32-gamemode
  mangohud
  lib32-mangohud
  goverlay
)

YAY_INSTALL_FLAGS=(
  --needed
  --noconfirm
  --answerdiff
  None
  --answerclean
  None
)

EXPORT_APPS=(
  steam
  lutris
  heroic
  protonplus
  goverlay
)

if [[ -t 1 && "${NO_COLOR:-}" == "" ]]; then
  readonly COLOR_BLUE=$'\033[34m'
  readonly COLOR_YELLOW=$'\033[33m'
  readonly COLOR_RED=$'\033[31m'
  readonly COLOR_GREEN=$'\033[32m'
  readonly COLOR_BOLD=$'\033[1m'
  readonly COLOR_RESET=$'\033[0m'
else
  readonly COLOR_BLUE=""
  readonly COLOR_YELLOW=""
  readonly COLOR_RED=""
  readonly COLOR_GREEN=""
  readonly COLOR_BOLD=""
  readonly COLOR_RESET=""
fi

print_status() {
  local color="$1"
  local label="$2"
  shift 2

  printf '\n%s%s%s %s\n' "$color" "$label" "$COLOR_RESET" "$*"
}

info() {
  print_status "$COLOR_BLUE" "[INFO]" "$@"
}

warn() {
  print_status "$COLOR_YELLOW" "[WARN]" "$@" >&2
}

error() {
  print_status "$COLOR_RED" "[ERROR]" "$@" >&2
}

ok() {
  print_status "$COLOR_GREEN" "[OK]" "$@"
}

die() {
  error "$*"
  exit 1
}

usage() {
  cat <<EOF
Usage: $0 [options]

Options:
  --debug, --dry-run    Affiche les commandes sans les executer
  -h, --help           Affiche cette aide

Variables:
  BOX_NAME             Nom de la distrobox (defaut: $DEFAULT_BOX_NAME)
  IMAGE                Image utilisee (defaut: $DEFAULT_IMAGE)
  CONTAINER_MANAGER    podman ou docker
  GPU_VENDOR           nvidia, amd, intel ou none
  USE_NVIDIA           y/n pour activer NVIDIA, conserve pour compatibilite
  BOX_HOME             Home dedie de la box (defaut: \$HOME/.distrobox/\$BOX_NAME)

EOF
}

format_command() {
  printf '%q ' "$@"
}

run_host() {
  if [[ "$DEBUG" == "y" ]]; then
    info "DRY-RUN: $(format_command "$@")"
    return 0
  fi

  "$@"
}

run_in_box() {
  local command="$1"

  run_host distrobox enter "$BOX_NAME" -- bash -lc "$command"
}

box_home() {
  printf '%s' "${BOX_HOME:-$HOME/.distrobox/$BOX_NAME}"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

resolve_container_manager() {
  case "$CONTAINER_MANAGER" in
    podman|docker)
      if command_exists "$CONTAINER_MANAGER"; then
        export DBX_CONTAINER_MANAGER="$CONTAINER_MANAGER"
        return 0
      fi

      if [[ "$DEBUG" == "y" ]]; then
        warn "Container manager absent sur l'hote: $CONTAINER_MANAGER"
        export DBX_CONTAINER_MANAGER="$CONTAINER_MANAGER"
        return 0
      fi

      die "Container manager manquant: $CONTAINER_MANAGER"
      ;;
    "")
      if command_exists podman; then
        CONTAINER_MANAGER="podman"
      elif command_exists docker; then
        CONTAINER_MANAGER="docker"
      elif [[ "$DEBUG" == "y" ]]; then
        CONTAINER_MANAGER="podman"
        warn "Aucun container manager detecte, dry-run avec: $CONTAINER_MANAGER"
      else
        die "Installez podman ou docker pour utiliser distrobox."
      fi

      export DBX_CONTAINER_MANAGER="$CONTAINER_MANAGER"
      ;;
    *)
      die "CONTAINER_MANAGER invalide: $CONTAINER_MANAGER. Utilisez podman ou docker."
      ;;
  esac
}

require_command() {
  if [[ "$DEBUG" == "y" ]]; then
    command_exists "$1" || warn "Commande absente sur l'hote: $1"
    return 0
  fi

  command_exists "$1" || die "Commande manquante: $1"
}

refuse_root() {
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    die "Ne lancez pas ce script en root. Utilisez votre utilisateur normal; sudo sera appele seulement dans la box."
  fi
}

pause() {
  printf '\nAppuyez sur Entree pour continuer...'
  read -r _
}

ask_text() {
  local prompt="$1"
  local default="$2"
  local value

  printf '%s [%s]: ' "$prompt" "$default"
  read -r value
  printf '%s' "${value:-$default}"
}

ask_yes_no() {
  local prompt="$1"
  local default="${2:-n}"
  local answer
  local suffix

  case "$default" in
    y|Y) suffix="Y/n" ;;
    *) suffix="y/N" ;;
  esac

  while true; do
    printf '%s [%s]: ' "$prompt" "$suffix"
    read -r answer
    answer="${answer:-$default}"

    case "$answer" in
      y|Y|yes|YES|Yes|o|O|oui|OUI|Oui) return 0 ;;
      n|N|no|NO|No|non|NON|Non) return 1 ;;
      *) warn "Reponse invalide. Utilisez y/n." ;;
    esac
  done
}

normalize_gpu_vendor() {
  local vendor="$1"

  case "$vendor" in
    nvidia|NVIDIA) printf 'nvidia' ;;
    amd|AMD|radeon|Radeon) printf 'amd' ;;
    intel|Intel|INTEL) printf 'intel' ;;
    none|NONE|no|No|n|N) printf 'none' ;;
    *) printf '' ;;
  esac
}

detect_gpu_vendor() {
  command_exists lspci || return 1

  if lspci | grep -Eiq 'VGA|3D|Display'; then
    if lspci | grep -Eiq '(VGA|3D|Display).*NVIDIA'; then
      printf 'nvidia'
      return 0
    fi

    if lspci | grep -Eiq '(VGA|3D|Display).*(AMD|ATI|Radeon)'; then
      printf 'amd'
      return 0
    fi

    if lspci | grep -Eiq '(VGA|3D|Display).*Intel'; then
      printf 'intel'
      return 0
    fi
  fi

  return 1
}

sync_nvidia_flag() {
  [[ "$GPU_VENDOR" == "nvidia" ]] && USE_NVIDIA="y" || USE_NVIDIA="n"
}

choose_gpu_vendor() {
  local detected="${1:-}"
  local default="${detected:-${GPU_VENDOR:-none}}"
  local choice

  while true; do
    printf 'GPU pour Vulkan (nvidia/amd/intel/none) [%s]: ' "$default"
    read -r choice
    choice="$(normalize_gpu_vendor "${choice:-$default}")"

    if [[ "$choice" != "" ]]; then
      GPU_VENDOR="$choice"
      sync_nvidia_flag
      return 0
    fi

    warn "GPU invalide. Utilisez nvidia, amd, intel ou none."
  done
}

configure_project() {
  local detected_gpu=""

  info "Configuration"
  BOX_NAME="$(ask_text "Nom de la distrobox" "$BOX_NAME")"
  IMAGE="$(ask_text "Image Arch Linux" "$IMAGE")"

  if detected_gpu="$(detect_gpu_vendor)"; then
    info "GPU detecte: $detected_gpu"
  fi

  choose_gpu_vendor "$detected_gpu"
}

print_summary() {
  cat <<EOF

Configuration actuelle
---------------------
Box        : $BOX_NAME
Image      : $IMAGE
Home       : $(box_home)
Runtime    : ${CONTAINER_MANAGER:-auto}
GPU        : $GPU_VENDOR
NVIDIA     : $USE_NVIDIA
Debug      : $DEBUG

EOF
}

confirm_step() {
  local label="$1"

  print_summary
  ask_yes_no "Executer: $label ?" "y"
}

check_requirements() {
  info "Verification des prerequis"
  require_command distrobox
  resolve_container_manager

  if [[ "$DEBUG" == "y" ]]; then
    ok "Verification des prerequis simulee avec $CONTAINER_MANAGER"
  else
    ok "Prerequis disponibles avec $CONTAINER_MANAGER"
  fi
}

box_exists() {
  [[ "$DEBUG" == "y" ]] && return 1

  "$CONTAINER_MANAGER" container inspect "$BOX_NAME" >/dev/null 2>&1
}

create_box() {
  local home_dir

  confirm_step "creation de la distrobox" || return 0

  check_requirements

  if box_exists; then
    ok "La box existe deja: $BOX_NAME"
    return 0
  fi

  home_dir="$(box_home)"

  local args=(
    create
    --name "$BOX_NAME"
    --image "$IMAGE"
    --home "$home_dir"
  )

  if [[ "$USE_NVIDIA" == "y" ]]; then
    args+=(--nvidia)
  fi

  info "Preparation du home dedie: $home_dir"
  run_host mkdir -p "$home_dir"

  info "Creation de la box $BOX_NAME"
  run_host distrobox "${args[@]}"

  if [[ "$DEBUG" == "y" ]]; then
    ok "Creation de box simulee: $BOX_NAME"
  else
    ok "Box creee: $BOX_NAME"
  fi
}

enter_box() {
  local command="$1"

  run_in_box "$command"
}

ensure_box_exists() {
  check_requirements

  if [[ "$DEBUG" == "y" ]]; then
    warn "Verification de l'existence de la box ignoree en debug."
    return 0
  fi

  box_exists || die "La box '$BOX_NAME' n'existe pas encore. Creez-la d'abord."
}

pacman_sync() {
  enter_box "sudo pacman -Syu --needed --noconfirm $*"
}

configure_pacman() {
  confirm_step "configuration de pacman.conf" || return 0
  ensure_box_exists

  info "Activation de Color et du depot multilib"
  enter_box '
    set -Eeuo pipefail

    pacman_conf="/etc/pacman.conf"

    if grep -qE "^#Color$" "$pacman_conf"; then
      sudo sed -i -E "s/^#Color$/Color/" "$pacman_conf"
    elif ! grep -qE "^Color$" "$pacman_conf"; then
      sudo sed -i "/^\[options\]/a Color" "$pacman_conf"
    fi

    if grep -qE "^#\[multilib\]$" "$pacman_conf"; then
      sudo sed -i -E "/^#\[multilib\]$/,+1 s/^#//" "$pacman_conf"
    elif ! grep -qE "^\[multilib\]$" "$pacman_conf"; then
      printf "\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n" | sudo tee -a "$pacman_conf" >/dev/null
    fi

    sudo pacman -Sy --noconfirm
  '

  if [[ "$DEBUG" == "y" ]]; then
    ok "Configuration de pacman.conf simulee"
  else
    ok "pacman.conf mis a jour"
  fi
}

install_base_devel() {
  confirm_step "installation de base-devel et prerequis" || return 0
  ensure_box_exists

  info "Installation des paquets de base"
  pacman_sync "${PACMAN_PACKAGES[*]}"

  if [[ "$DEBUG" == "y" ]]; then
    ok "Installation des paquets de base simulee"
  else
    ok "Paquets de base installes"
  fi
}

tune_makepkg() {
  confirm_step "optimisation de /etc/makepkg.conf" || return 0
  ensure_box_exists

  info "Configuration de MAKEFLAGS et des options makepkg"
  enter_box '
    set -Eeuo pipefail

    makepkg_conf="/etc/makepkg.conf"
    cores=$(nproc)

    if grep -qE "^#?MAKEFLAGS=" "$makepkg_conf"; then
      sudo sed -i -E "s/^#?MAKEFLAGS=.*/MAKEFLAGS=\"-j${cores}\"/" "$makepkg_conf"
    else
      echo "MAKEFLAGS=\"-j${cores}\"" | sudo tee -a "$makepkg_conf" >/dev/null
    fi

    if grep -qE "^OPTIONS=.*(^|[[:space:]]|\()!debug([[:space:]]|\))" "$makepkg_conf"; then
      exit 0
    fi

    if grep -qE "^OPTIONS=.*(^|[[:space:]]|\()debug([[:space:]]|\))" "$makepkg_conf"; then
      sudo sed -i -E "/^OPTIONS=/ s/(^|[[:space:]]|\()debug([[:space:]]|\))/\1!debug\2/" "$makepkg_conf"
    elif grep -qE "^OPTIONS=\(" "$makepkg_conf"; then
      sudo sed -i -E "/^OPTIONS=/ s/\)[[:space:]]*$/ !debug)/" "$makepkg_conf"
    else
      echo "OPTIONS=(!debug)" | sudo tee -a "$makepkg_conf" >/dev/null
    fi
  '

  if [[ "$DEBUG" == "y" ]]; then
    ok "Modification de makepkg.conf simulee"
  else
    ok "makepkg.conf mis a jour"
  fi
}

install_nvidia_packages() {
  [[ "$GPU_VENDOR" == "nvidia" ]] || return 0

  confirm_step "installation des paquets Vulkan NVIDIA" || return 0
  ensure_box_exists

  info "Installation des bibliotheques Vulkan NVIDIA"
  pacman_sync "${COMMON_VULKAN_PACKAGES[*]} ${NVIDIA_PACKAGES[*]}"

  if [[ "$DEBUG" == "y" ]]; then
    ok "Installation des paquets Vulkan NVIDIA simulee"
  else
    ok "Paquets Vulkan NVIDIA installes"
  fi
}

install_amd_vulkan_packages() {
  [[ "$GPU_VENDOR" == "amd" ]] || return 0

  confirm_step "installation des paquets Vulkan AMD" || return 0
  ensure_box_exists

  info "Installation des bibliotheques Vulkan AMD"
  pacman_sync "${COMMON_VULKAN_PACKAGES[*]} ${AMD_VULKAN_PACKAGES[*]}"

  if [[ "$DEBUG" == "y" ]]; then
    ok "Installation des paquets Vulkan AMD simulee"
  else
    ok "Paquets Vulkan AMD installes"
  fi
}

install_intel_vulkan_packages() {
  [[ "$GPU_VENDOR" == "intel" ]] || return 0

  confirm_step "installation des paquets Vulkan Intel" || return 0
  ensure_box_exists

  info "Installation des bibliotheques Vulkan Intel"
  pacman_sync "${COMMON_VULKAN_PACKAGES[*]} ${INTEL_VULKAN_PACKAGES[*]}"

  if [[ "$DEBUG" == "y" ]]; then
    ok "Installation des paquets Vulkan Intel simulee"
  else
    ok "Paquets Vulkan Intel installes"
  fi
}

install_vulkan_packages() {
  case "$GPU_VENDOR" in
    nvidia) install_nvidia_packages ;;
    amd) install_amd_vulkan_packages ;;
    intel) install_intel_vulkan_packages ;;
    none) warn "Aucun GPU Vulkan selectionne, installation Vulkan ignoree." ;;
    *) die "GPU inconnu: $GPU_VENDOR" ;;
  esac
}

install_yay_bin() {
  confirm_step "installation de yay-bin" || return 0
  ensure_box_exists

  info "Installation de yay-bin depuis AUR"
  enter_box "
    set -Eeuo pipefail
    if command -v yay >/dev/null 2>&1; then
      echo 'yay est deja installe.'
      exit 0
    fi
    tmpdir=\$(mktemp -d)
    trap 'rm -rf \"\$tmpdir\"' EXIT
    git clone https://aur.archlinux.org/yay-bin.git \"\$tmpdir/yay-bin\"
    cd \"\$tmpdir/yay-bin\"
    makepkg -si --noconfirm
  "

  if [[ "$DEBUG" == "y" ]]; then
    ok "Installation de yay-bin simulee"
  else
    ok "yay-bin installe"
  fi
}

install_gaming_apps() {
  confirm_step "installation des applications gaming" || return 0
  ensure_box_exists

  enter_box "command -v yay >/dev/null 2>&1" || die "yay est manquant. Installez yay-bin avant les applications gaming."

  info "Installation des applications gaming via yay"
  enter_box "yay -S ${YAY_INSTALL_FLAGS[*]} ${GAMING_PACKAGES[*]}"

  if [[ "$DEBUG" == "y" ]]; then
    ok "Installation des applications gaming simulee"
  else
    ok "Applications gaming installees"
  fi
}

export_gaming_apps() {
  confirm_step "export des applications gaming vers l'hote" || return 0
  ensure_box_exists

  info "Export des applications: ${EXPORT_APPS[*]}"
  for app in "${EXPORT_APPS[@]}"; do
    enter_box "distrobox-export --app '$app'"
  done

  if [[ "$DEBUG" == "y" ]]; then
    ok "Export des applications gaming simule"
  else
    ok "Applications gaming exportees"
  fi
}

full_deploy() {
  create_box
  configure_pacman
  install_base_devel
  tune_makepkg
  install_vulkan_packages
  install_yay_bin
  install_gaming_apps
  export_gaming_apps
}

show_menu() {
  if [[ -t 1 && "${TERM:-}" != "" ]]; then
    clear
  fi

  cat <<EOF
dbx-arch-gaming
===============

Box    : $BOX_NAME
Image  : $IMAGE
Home   : $(box_home)
Runtime: ${CONTAINER_MANAGER:-auto}
GPU    : $GPU_VENDOR
NVIDIA : $USE_NVIDIA
Debug  : $DEBUG

1. Configurer
2. Creer la box
3. Modifier pacman.conf
4. Installer base-devel
5. Modifier makepkg.conf
6. Installer Vulkan GPU
7. Installer yay-bin
8. Installer les apps gaming
9. Exporter les apps gaming
10. Deploiement complet
0. Quitter

EOF
}

main_menu() {
  local choice

  while true; do
    show_menu
    printf 'Choix: '
    read -r choice

    case "$choice" in
      1) configure_project; pause ;;
      2) create_box; pause ;;
      3) configure_pacman; pause ;;
      4) install_base_devel; pause ;;
      5) tune_makepkg; pause ;;
      6) install_vulkan_packages; pause ;;
      7) install_yay_bin; pause ;;
      8) install_gaming_apps; pause ;;
      9) export_gaming_apps; pause ;;
      10) full_deploy; pause ;;
      0) exit 0 ;;
      *) warn "Choix invalide"; pause ;;
    esac
  done
}

parse_args() {
  while (($# > 0)); do
    case "$1" in
      --debug|--dry-run)
        DEBUG="y"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Option inconnue: $1"
        ;;
    esac
    shift
  done
}

main() {
  GPU_VENDOR="$(normalize_gpu_vendor "${GPU_VENDOR:-}")"
  if [[ "$GPU_VENDOR" == "" ]]; then
    if [[ "${USE_NVIDIA:-n}" == "y" ]]; then
      GPU_VENDOR="nvidia"
    else
      GPU_VENDOR="none"
    fi
  fi
  sync_nvidia_flag

  parse_args "$@"
  refuse_root
  main_menu
}

main "$@"
